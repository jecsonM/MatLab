syms x a n;

lim1 = limit( (x^2-5*x+6)/(x^2-8*x+15), x, 3) 
lim2 = limit( (tan(a+2*x)-2*tan(a+x)+tan(a))/(x^2), x, 0)


assume(x > 0);
assume(n, 'positive')          
assumeAlso(n, 'integer');

lim3 = limit( (n^2)*(x^(1/n) - x^(1/(n+1))) , x, Inf)

syms x;
diff1 =  diff(x * (log(x+sqrt(1+x^2)))^2, x, 1)


syms a b;
diff2 =  diff( 2/(sqrt (a^2-b^2) , x, 1)